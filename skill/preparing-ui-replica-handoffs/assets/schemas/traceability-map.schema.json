{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UI evidence to implementation traceability map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entries"],
  "properties": { "schemaVersion": { "const": "1.0.0" }, "entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entry" } } },
  "$defs": {
    "relativePath": { "type": "string", "minLength": 1, "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "identity": { "type": "object", "additionalProperties": false, "required": ["pageId", "stateId", "variantId"], "properties": { "pageId": { "type": "string", "pattern": "^P[0-9]{3,}$" }, "stateId": { "type": "string", "pattern": "^S[0-9]{2,}$" }, "variantId": { "type": "string", "pattern": "^V[0-9]{2,}$" } } },
    "bounds": { "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"], "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 } } },
    "gapIds": { "type": "array", "items": { "type": "string", "pattern": "^G[0-9]{3,}$" }, "uniqueItems": true },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["traceabilityId", "sourceReferenceIds", "sourceRuleIds", "sourceBounds", "tokenIds", "componentIds", "microVisualFeatureIds", "pageIdentities", "implementationTargets", "qaIds", "status", "evidenceLevel", "gapIds"],
      "properties": {
        "traceabilityId": { "type": "string", "pattern": "^TR[0-9]{3,}$" },
        "sourceReferenceIds": { "type": "array", "items": { "type": "string", "pattern": "^REF[0-9]{3,}$" }, "minItems": 1, "uniqueItems": true },
        "sourceRuleIds": { "type": "array", "items": { "type": "string", "pattern": "^DR[0-9]{3,}$" }, "uniqueItems": true },
        "sourceBounds": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["referenceId", "bounds"], "properties": { "referenceId": { "type": "string", "pattern": "^REF[0-9]{3,}$" }, "bounds": { "$ref": "#/$defs/bounds" } } } },
        "tokenIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "componentIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "microVisualFeatureIds": { "type": "array", "items": { "type": "string", "pattern": "^MV[0-9]{3,}$" }, "uniqueItems": true },
        "pageIdentities": { "type": "array", "items": { "$ref": "#/$defs/identity" }, "minItems": 1 },
        "implementationTargets": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["file", "symbol"], "properties": { "file": { "anyOf": [{ "$ref": "#/$defs/relativePath" }, { "type": "null" }] }, "symbol": { "type": ["string", "null"] } } } },
        "qaIds": { "type": "array", "items": { "type": "string", "pattern": "^QA[0-9]{3,}$" }, "minItems": 1, "uniqueItems": true },
        "status": { "enum": ["unknown", "proposed", "candidate", "approved"] },
        "evidenceLevel": { "enum": ["direct", "derived", "candidate", "approved", "unknown"] },
        "gapIds": { "$ref": "#/$defs/gapIds" }
      },
      "allOf": [{ "if": { "anyOf": [{ "properties": { "status": { "enum": ["unknown", "proposed"] } } }, { "properties": { "evidenceLevel": { "const": "unknown" } } }] }, "then": { "properties": { "gapIds": { "minItems": 1 } } } }]
    }
  }
}
