{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UI component registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "components"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "components": {
      "type": "array",
      "items": { "$ref": "#/$defs/component" }
    }
  },
  "$defs": {
    "evidenceLevel": {
      "enum": ["direct", "derived", "candidate", "approved", "unknown"]
    },
    "lifecycleStatus": {
      "enum": ["unknown", "proposed", "candidate", "approved"]
    },
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zh-CN", "en-US"],
      "properties": {
        "zh-CN": { "type": "string" },
        "en-US": { "type": "string" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pageId", "stateId", "variantId"],
      "properties": {
        "pageId": { "type": "string", "pattern": "^P[0-9]{3,}$" },
        "stateId": { "type": "string", "pattern": "^S[0-9]{2,}$" },
        "variantId": { "type": "string", "pattern": "^V[0-9]{2,}$" }
      }
    },
    "gapIds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^G[0-9]{3,}$" },
      "uniqueItems": true
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componentId",
        "name",
        "status",
        "evidenceLevel",
        "sourcePageIdentities",
        "anatomy",
        "variants",
        "states",
        "props",
        "interactions",
        "styleTokenRefs",
        "gapIds"
      ],
      "properties": {
        "componentId": { "type": "string", "minLength": 1 },
        "name": { "$ref": "#/$defs/localizedText" },
        "status": { "$ref": "#/$defs/lifecycleStatus" },
        "evidenceLevel": { "$ref": "#/$defs/evidenceLevel" },
        "sourcePageIdentities": {
          "type": "array",
          "items": { "$ref": "#/$defs/identity" },
          "minItems": 1
        },
        "anatomy": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "variants": {
          "type": "array",
          "items": { "$ref": "#/$defs/variant" }
        },
        "states": {
          "type": "array",
          "items": { "$ref": "#/$defs/state" }
        },
        "props": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["propId", "type", "required", "evidenceLevel", "gapIds"],
            "properties": {
              "propId": { "type": "string", "minLength": 1 },
              "type": { "type": "string", "minLength": 1 },
              "required": { "type": "boolean" },
              "evidenceLevel": { "$ref": "#/$defs/evidenceLevel" },
              "gapIds": { "$ref": "#/$defs/gapIds" }
            },
            "allOf": [
              {
                "if": {
                  "properties": { "evidenceLevel": { "const": "unknown" } },
                  "required": ["evidenceLevel"]
                },
                "then": { "properties": { "gapIds": { "minItems": 1 } } }
              }
            ]
          }
        },
        "interactions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "interactionId",
              "trigger",
              "outcome",
              "status",
              "evidenceLevel",
              "gapId"
            ],
            "properties": {
              "interactionId": { "type": "string", "minLength": 1 },
              "trigger": { "type": "string", "minLength": 1 },
              "outcome": { "$ref": "#/$defs/localizedText" },
              "status": { "$ref": "#/$defs/lifecycleStatus" },
              "evidenceLevel": { "$ref": "#/$defs/evidenceLevel" },
              "gapId": { "type": ["string", "null"], "pattern": "^G[0-9]{3,}$" }
            },
            "allOf": [
              {
                "if": {
                  "anyOf": [
                    {
                      "properties": { "status": { "enum": ["unknown", "proposed"] } },
                      "required": ["status"]
                    },
                    {
                      "properties": { "evidenceLevel": { "const": "unknown" } },
                      "required": ["evidenceLevel"]
                    }
                  ]
                },
                "then": { "properties": { "gapId": { "type": "string" } } }
              }
            ]
          }
        },
        "styleTokenRefs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "gapIds": { "$ref": "#/$defs/gapIds" }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "properties": { "status": { "enum": ["unknown", "proposed"] } },
                "required": ["status"]
              },
              {
                "properties": { "evidenceLevel": { "const": "unknown" } },
                "required": ["evidenceLevel"]
              }
            ]
          },
          "then": { "properties": { "gapIds": { "minItems": 1 } } }
        }
      ]
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stateId", "status", "evidenceLevel", "gapIds"],
      "properties": {
        "stateId": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/lifecycleStatus" },
        "evidenceLevel": { "$ref": "#/$defs/evidenceLevel" },
        "gapIds": { "$ref": "#/$defs/gapIds" }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "properties": { "status": { "enum": ["unknown", "proposed"] } },
                "required": ["status"]
              },
              {
                "properties": { "evidenceLevel": { "const": "unknown" } },
                "required": ["evidenceLevel"]
              }
            ]
          },
          "then": { "properties": { "gapIds": { "minItems": 1 } } }
        }
      ]
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variantId", "status", "evidenceLevel", "gapIds"],
      "properties": {
        "variantId": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/lifecycleStatus" },
        "evidenceLevel": { "$ref": "#/$defs/evidenceLevel" },
        "gapIds": { "$ref": "#/$defs/gapIds" }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "properties": { "status": { "enum": ["unknown", "proposed"] } },
                "required": ["status"]
              },
              {
                "properties": { "evidenceLevel": { "const": "unknown" } },
                "required": ["evidenceLevel"]
              }
            ]
          },
          "then": { "properties": { "gapIds": { "minItems": 1 } } }
        }
      ]
    }
  }
}
