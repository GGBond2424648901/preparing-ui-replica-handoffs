{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UI style contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceLevel",
    "status",
    "tokens",
    "responsiveVariants",
    "gapIds"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "evidenceLevel": { "$ref": "#/$defs/evidenceLevel" },
    "status": { "$ref": "#/$defs/lifecycleStatus" },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "colors", "typography", "spacing", "radii", "shadows", "borders",
        "opacity", "gradients", "blur", "materials", "layers", "motion",
        "iconography", "chartLanguage", "density", "backgrounds", "forbiddenPatterns"
      ],
      "properties": {
        "colors": { "$ref": "#/$defs/tokenList" },
        "typography": { "$ref": "#/$defs/tokenList" },
        "spacing": { "$ref": "#/$defs/tokenList" },
        "radii": { "$ref": "#/$defs/tokenList" },
        "shadows": { "$ref": "#/$defs/tokenList" },
        "borders": { "$ref": "#/$defs/tokenList" },
        "opacity": { "$ref": "#/$defs/tokenList" },
        "gradients": { "$ref": "#/$defs/tokenList" },
        "blur": { "$ref": "#/$defs/tokenList" },
        "materials": { "$ref": "#/$defs/tokenList" },
        "layers": { "$ref": "#/$defs/tokenList" },
        "motion": { "$ref": "#/$defs/tokenList" },
        "iconography": { "$ref": "#/$defs/tokenList" },
        "chartLanguage": { "$ref": "#/$defs/tokenList" },
        "density": { "$ref": "#/$defs/tokenList" },
        "backgrounds": { "$ref": "#/$defs/tokenList" },
        "forbiddenPatterns": { "$ref": "#/$defs/tokenList" }
      }
    },
    "responsiveVariants": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "type": "object",
        "properties": { "mode": { "enum": ["baseline-elastic", "baseline-scroll"] } },
        "required": ["mode"]
      },
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["responsiveVariantId", "mode", "targetPlatform", "layoutPolicy", "evidenceLevel", "status", "gapIds"],
        "properties": {
          "responsiveVariantId": { "type": "string", "minLength": 1 },
          "mode": { "enum": ["baseline-elastic", "baseline-scroll", "responsive"] },
          "targetPlatform": {
            "enum": ["desktop-web", "mobile-web", "responsive-web", "desktop-native", "unknown"]
          },
          "layoutPolicy": {
            "enum": ["desktop-hybrid-elastic", "fully-fluid", "fixed-baseline", "evidence-defined", "unknown"]
          },
          "evidenceLevel": { "$ref": "#/$defs/evidenceLevel" },
          "status": { "$ref": "#/$defs/lifecycleStatus" },
          "gapIds": { "$ref": "#/$defs/gapIds" }
        },
        "allOf": [
          {
            "if": {
              "anyOf": [
                {
                  "properties": { "status": { "enum": ["unknown", "proposed"] } },
                  "required": ["status"]
                },
                {
                  "properties": { "evidenceLevel": { "const": "unknown" } },
                  "required": ["evidenceLevel"]
                },
                {
                  "properties": { "targetPlatform": { "const": "unknown" } },
                  "required": ["targetPlatform"]
                },
                {
                  "properties": { "layoutPolicy": { "const": "unknown" } },
                  "required": ["layoutPolicy"]
                }
              ]
            },
            "then": { "properties": { "gapIds": { "minItems": 1 } } }
          },
          {
            "if": {
              "properties": { "mode": { "const": "responsive" } },
              "required": ["mode"]
            },
            "then": {
              "anyOf": [
                {
                  "properties": { "evidenceLevel": { "enum": ["direct", "approved"] } },
                  "required": ["evidenceLevel"]
                },
                {
                  "properties": { "status": { "const": "approved" } },
                  "required": ["status"]
                }
              ]
            }
          }
        ]
      }
    },
    "gapIds": { "$ref": "#/$defs/gapIds" }
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "properties": { "status": { "enum": ["unknown", "proposed"] } },
            "required": ["status"]
          },
          {
            "properties": { "evidenceLevel": { "const": "unknown" } },
            "required": ["evidenceLevel"]
          }
        ]
      },
      "then": { "properties": { "gapIds": { "minItems": 1 } } }
    }
  ],
  "$defs": {
    "evidenceLevel": {
      "enum": ["direct", "derived", "candidate", "approved", "unknown"]
    },
    "lifecycleStatus": {
      "enum": ["unknown", "proposed", "candidate", "approved"]
    },
    "gapIds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^G[0-9]{3,}$" },
      "uniqueItems": true
    },
    "tokenList": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tokenId", "value", "evidenceLevel", "status", "gapIds"],
        "properties": {
          "tokenId": { "type": "string", "minLength": 1 },
          "value": {},
          "evidenceLevel": { "$ref": "#/$defs/evidenceLevel" },
          "status": { "$ref": "#/$defs/lifecycleStatus" },
          "gapIds": { "$ref": "#/$defs/gapIds" }
        },
        "allOf": [
          {
            "if": {
              "anyOf": [
                {
                  "properties": { "status": { "enum": ["unknown", "proposed"] } },
                  "required": ["status"]
                },
                {
                  "properties": { "evidenceLevel": { "const": "unknown" } },
                  "required": ["evidenceLevel"]
                }
              ]
            },
            "then": { "properties": { "gapIds": { "minItems": 1 } } }
          }
        ]
      }
    }
  }
}
