{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UI style contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceLevel",
    "status",
    "tokens",
    "responsiveVariants",
    "gapIds"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "evidenceLevel": { "$ref": "#/$defs/evidenceLevel" },
    "status": { "$ref": "#/$defs/lifecycleStatus" },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["colors", "typography", "spacing", "radii", "shadows"],
      "properties": {
        "colors": { "$ref": "#/$defs/tokenList" },
        "typography": { "$ref": "#/$defs/tokenList" },
        "spacing": { "$ref": "#/$defs/tokenList" },
        "radii": { "$ref": "#/$defs/tokenList" },
        "shadows": { "$ref": "#/$defs/tokenList" }
      }
    },
    "responsiveVariants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["responsiveVariantId", "mode", "evidenceLevel", "status", "gapIds"],
        "properties": {
          "responsiveVariantId": { "type": "string", "minLength": 1 },
          "mode": { "enum": ["baseline-scroll", "responsive"] },
          "evidenceLevel": { "$ref": "#/$defs/evidenceLevel" },
          "status": { "$ref": "#/$defs/lifecycleStatus" },
          "gapIds": { "$ref": "#/$defs/gapIds" }
        }
      }
    },
    "gapIds": { "$ref": "#/$defs/gapIds" }
  },
  "$defs": {
    "evidenceLevel": {
      "enum": ["direct", "derived", "candidate", "approved", "unknown"]
    },
    "lifecycleStatus": {
      "enum": ["unknown", "proposed", "candidate", "approved"]
    },
    "gapIds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^G[0-9]{3,}$" },
      "uniqueItems": true
    },
    "tokenList": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tokenId", "value", "evidenceLevel", "status", "gapIds"],
        "properties": {
          "tokenId": { "type": "string", "minLength": 1 },
          "value": {},
          "evidenceLevel": { "$ref": "#/$defs/evidenceLevel" },
          "status": { "$ref": "#/$defs/lifecycleStatus" },
          "gapIds": { "$ref": "#/$defs/gapIds" }
        }
      }
    }
  }
}
