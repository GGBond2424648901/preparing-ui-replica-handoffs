{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence-bounded UI motion and micro-interaction contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "motions"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "motions": { "type": "array", "items": { "$ref": "#/$defs/motion" } }
  },
  "$defs": {
    "localizedText": {
      "type": "object", "additionalProperties": false, "required": ["zh-CN", "en-US"],
      "properties": { "zh-CN": { "type": "string" }, "en-US": { "type": "string" } }
    },
    "bounds": {
      "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number" }, "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "gapIds": {
      "type": "array", "items": { "type": "string", "pattern": "^G[0-9]{3,}$" }, "uniqueItems": true
    },
    "reducedMotion": {
      "type": "object", "additionalProperties": false,
      "required": ["strategy", "durationMs", "finalState"],
      "properties": {
        "strategy": { "enum": ["preserve", "shorten", "remove-transform", "crossfade", "instant", "unknown"] },
        "durationMs": { "type": ["number", "null"], "minimum": 0 },
        "finalState": { "type": "object" }
      }
    },
    "motion": {
      "type": "object", "additionalProperties": false,
      "required": [
        "motionId", "name", "targetType", "targetIds", "trigger", "sourceEvidence",
        "initialState", "finalState", "durationMs", "delayMs", "easing",
        "animatedProperties", "transformOrigin", "layerBehavior", "pointerBehavior",
        "focusBehavior", "reducedMotion", "stateFrameReferenceIds", "status",
        "evidenceLevel", "gapIds"
      ],
      "properties": {
        "motionId": { "type": "string", "pattern": "^MOT[0-9]{3,}$" },
        "name": { "$ref": "#/$defs/localizedText" },
        "targetType": { "enum": ["navigation", "button", "selection-control", "search", "input", "component", "page", "overlay", "chart", "other"] },
        "targetIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "trigger": { "enum": ["hover", "focus", "focus-visible", "press", "click", "select", "expand", "collapse", "enter", "exit", "load", "scroll", "drag", "drop", "state-change", "automatic"] },
        "sourceEvidence": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["referenceId", "bounds"],
            "properties": {
              "referenceId": { "type": "string", "pattern": "^REF[0-9]{3,}$" },
              "bounds": { "anyOf": [{ "$ref": "#/$defs/bounds" }, { "type": "null" }] }
            }
          }
        },
        "initialState": { "type": "object" },
        "finalState": { "type": "object" },
        "durationMs": { "type": ["number", "null"], "minimum": 0 },
        "delayMs": { "type": ["number", "null"], "minimum": 0 },
        "easing": { "type": ["string", "null"] },
        "animatedProperties": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "transformOrigin": { "type": ["string", "null"] },
        "layerBehavior": { "type": ["string", "null"] },
        "pointerBehavior": { "type": ["string", "null"] },
        "focusBehavior": { "type": ["string", "null"] },
        "reducedMotion": { "$ref": "#/$defs/reducedMotion" },
        "stateFrameReferenceIds": { "type": "array", "items": { "type": "string", "pattern": "^REF[0-9]{3,}$" }, "uniqueItems": true },
        "status": { "enum": ["unknown", "proposed", "candidate", "approved"] },
        "evidenceLevel": { "enum": ["direct", "derived", "candidate", "approved", "unknown"] },
        "gapIds": { "$ref": "#/$defs/gapIds" }
      },
      "allOf": [
        {
          "if": { "anyOf": [
            { "properties": { "status": { "enum": ["unknown", "proposed"] } } },
            { "properties": { "evidenceLevel": { "const": "unknown" } } },
            { "properties": { "durationMs": { "type": "null" } } },
            { "properties": { "easing": { "type": "null" } } }
          ] },
          "then": { "properties": { "gapIds": { "minItems": 1 } } }
        }
      ]
    }
  }
}
