{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UI capture environment profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "acceptancePolicy", "profiles"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "acceptancePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalPurpose", "canonicalEnvironmentMustBeLocked", "scoreOnlyCanonical",
        "requiredStabilityPurposes", "stabilityProfilesAffectReplicaScore"
      ],
      "properties": {
        "canonicalPurpose": { "const": "baseline" },
        "canonicalEnvironmentMustBeLocked": { "const": true },
        "scoreOnlyCanonical": { "const": true },
        "requiredStabilityPurposes": {
          "type": "array",
          "prefixItems": [{ "const": "wide" }, { "const": "narrow" }, { "const": "zoom" }],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "stabilityProfilesAffectReplicaScore": { "const": false }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "evidenceLevel": {
      "enum": ["direct", "derived", "candidate", "approved", "unknown"]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "captureProfileId",
        "pageId",
        "stateId",
        "variantId",
        "purpose",
        "acceptanceRole",
        "scoreContribution",
        "environmentLock",
        "targetPlatform",
        "layoutPolicy",
        "browser",
        "browserVersion",
        "viewport",
        "dpr",
        "locale",
        "timezone",
        "theme",
        "zoom",
        "fontEnvironment",
        "colorScheme",
        "reducedMotion",
        "evidenceLevel",
        "gapIds"
      ],
      "properties": {
        "captureProfileId": { "type": "string", "minLength": 1 },
        "pageId": { "type": "string", "pattern": "^P[0-9]{3,}$" },
        "stateId": { "type": "string", "pattern": "^S[0-9]{2,}$" },
        "variantId": { "type": "string", "pattern": "^V[0-9]{2,}$" },
        "purpose": { "enum": ["baseline", "wide", "narrow", "zoom", "custom"] },
        "acceptanceRole": { "enum": ["replica-score", "stability-only", "custom"] },
        "scoreContribution": { "type": "boolean" },
        "environmentLock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["viewport", "zoom", "dpr", "browser", "browserVersion", "locale", "fonts"],
          "properties": {
            "viewport": { "type": "boolean" },
            "zoom": { "type": "boolean" },
            "dpr": { "type": "boolean" },
            "browser": { "type": "boolean" },
            "browserVersion": { "type": "boolean" },
            "locale": { "type": "boolean" },
            "fonts": { "type": "boolean" }
          }
        },
        "targetPlatform": {
          "enum": ["desktop-web", "mobile-web", "responsive-web", "desktop-native", "unknown"]
        },
        "layoutPolicy": {
          "enum": ["desktop-hybrid-elastic", "fully-fluid", "fixed-baseline", "evidence-defined", "unknown"]
        },
        "browser": { "type": "string", "minLength": 1 },
        "browserVersion": { "type": "string", "minLength": 1 },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          }
        },
        "dpr": { "type": "number", "exclusiveMinimum": 0 },
        "locale": { "type": "string", "minLength": 1 },
        "timezone": { "type": "string", "minLength": 1 },
        "theme": { "enum": ["light", "dark", "system", "unknown"] },
        "zoom": {
          "oneOf": [
            { "type": "number", "exclusiveMinimum": 0 },
            { "const": "unknown" }
          ]
        },
        "fontEnvironment": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "colorScheme": { "enum": ["light", "dark", "no-preference"] },
        "reducedMotion": { "type": "boolean" },
        "evidenceLevel": { "$ref": "#/$defs/evidenceLevel" },
        "gapIds": {
          "type": "array",
          "items": { "type": "string", "pattern": "^G[0-9]{3,}$" },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "purpose": { "const": "baseline" } },
            "required": ["purpose"]
          },
          "then": {
            "properties": {
              "acceptanceRole": { "const": "replica-score" },
              "scoreContribution": { "const": true },
              "environmentLock": {
                "properties": {
                  "viewport": { "const": true },
                  "zoom": { "const": true },
                  "dpr": { "const": true },
                  "browser": { "const": true },
                  "browserVersion": { "const": true },
                  "locale": { "const": true },
                  "fonts": { "const": true }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "purpose": { "enum": ["wide", "narrow", "zoom"] } },
            "required": ["purpose"]
          },
          "then": {
            "properties": {
              "acceptanceRole": { "const": "stability-only" },
              "scoreContribution": { "const": false }
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "properties": { "evidenceLevel": { "const": "unknown" } },
                "required": ["evidenceLevel"]
              },
              {
                "properties": { "theme": { "const": "unknown" } },
                "required": ["theme"]
              },
              {
                "properties": { "zoom": { "const": "unknown" } },
                "required": ["zoom"]
              },
              {
                "properties": { "targetPlatform": { "const": "unknown" } },
                "required": ["targetPlatform"]
              },
              {
                "properties": { "layoutPolicy": { "const": "unknown" } },
                "required": ["layoutPolicy"]
              }
            ]
          },
          "then": { "properties": { "gapIds": { "minItems": 1 } } }
        }
      ]
    }
  }
}
