{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UI capture environment profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profiles"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "profiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "evidenceLevel": {
      "enum": ["direct", "derived", "candidate", "approved", "unknown"]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "captureProfileId",
        "browser",
        "browserVersion",
        "viewport",
        "dpr",
        "locale",
        "timezone",
        "theme",
        "fontEnvironment",
        "colorScheme",
        "reducedMotion",
        "evidenceLevel"
      ],
      "properties": {
        "captureProfileId": { "type": "string", "minLength": 1 },
        "browser": { "type": "string", "minLength": 1 },
        "browserVersion": { "type": "string", "minLength": 1 },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          }
        },
        "dpr": { "type": "number", "exclusiveMinimum": 0 },
        "locale": { "type": "string", "minLength": 1 },
        "timezone": { "type": "string", "minLength": 1 },
        "theme": { "enum": ["light", "dark", "system", "unknown"] },
        "fontEnvironment": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "colorScheme": { "enum": ["light", "dark", "no-preference"] },
        "reducedMotion": { "type": "boolean" },
        "evidenceLevel": { "$ref": "#/$defs/evidenceLevel" }
      }
    }
  }
}
