{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence-bounded semantic visual encoding contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "dimensions"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "dimensions": {
      "type": "array",
      "items": { "$ref": "#/$defs/dimension" }
    }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zh-CN", "en-US"],
      "properties": {
        "zh-CN": { "type": "string" },
        "en-US": { "type": "string" }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "gapIds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^G[0-9]{3,}$" },
      "uniqueItems": true
    },
    "colorReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokenId", "rawValue"],
      "properties": {
        "tokenId": { "type": ["string", "null"] },
        "rawValue": { "type": ["string", "null"] }
      }
    },
    "sourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["referenceId", "bounds"],
      "properties": {
        "referenceId": { "type": "string", "pattern": "^REF[0-9]{3,}$" },
        "bounds": { "$ref": "#/$defs/bounds" }
      }
    },
    "semanticValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semanticValueId", "code", "label", "meaning", "shape", "colorRoles",
        "geometry", "typography", "interactionStates", "ordering",
        "contrastRequirement", "sourceEvidence", "status", "evidenceLevel", "gapIds"
      ],
      "properties": {
        "semanticValueId": { "type": "string", "pattern": "^SEMVAL[0-9]{3,}$" },
        "code": { "type": "string", "minLength": 1 },
        "label": { "$ref": "#/$defs/localizedText" },
        "meaning": { "$ref": "#/$defs/localizedText" },
        "shape": { "enum": ["pill", "dot-pill", "dot-label", "badge", "icon-label", "text", "custom"] },
        "colorRoles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "background", "border", "indicator", "icon"],
          "properties": {
            "text": { "$ref": "#/$defs/colorReference" },
            "background": { "$ref": "#/$defs/colorReference" },
            "border": { "$ref": "#/$defs/colorReference" },
            "indicator": { "$ref": "#/$defs/colorReference" },
            "icon": { "$ref": "#/$defs/colorReference" }
          }
        },
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["height", "minWidth", "paddingX", "paddingY", "gap", "radius", "borderWidth", "indicatorDiameter", "iconSize"],
          "properties": {
            "height": { "type": ["number", "null"], "minimum": 0 },
            "minWidth": { "type": ["number", "null"], "minimum": 0 },
            "paddingX": { "type": ["number", "null"], "minimum": 0 },
            "paddingY": { "type": ["number", "null"], "minimum": 0 },
            "gap": { "type": ["number", "null"], "minimum": 0 },
            "radius": { "type": ["number", "null"], "minimum": 0 },
            "borderWidth": { "type": ["number", "null"], "minimum": 0 },
            "indicatorDiameter": { "type": ["number", "null"], "minimum": 0 },
            "iconSize": { "type": ["number", "null"], "minimum": 0 }
          }
        },
        "typography": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fontTokenId", "fontSize", "fontWeight", "lineHeight"],
          "properties": {
            "fontTokenId": { "type": ["string", "null"] },
            "fontSize": { "type": ["number", "null"], "minimum": 0 },
            "fontWeight": { "type": ["number", "null"], "minimum": 1 },
            "lineHeight": { "type": ["number", "null"], "minimum": 0 }
          }
        },
        "interactionStates": {
          "type": "array",
          "items": { "enum": ["default", "hover", "focus", "focus-visible", "pressed", "selected", "disabled", "loading"] },
          "uniqueItems": true
        },
        "ordering": { "type": ["integer", "null"] },
        "contrastRequirement": { "type": ["string", "null"] },
        "sourceEvidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceEvidence" }
        },
        "status": { "enum": ["unknown", "proposed", "candidate", "approved"] },
        "evidenceLevel": { "enum": ["direct", "derived", "candidate", "approved", "unknown"] },
        "gapIds": { "$ref": "#/$defs/gapIds" }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              { "properties": { "status": { "enum": ["unknown", "proposed"] } } },
              { "properties": { "evidenceLevel": { "const": "unknown" } } }
            ]
          },
          "then": { "properties": { "gapIds": { "minItems": 1 } } }
        }
      ]
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semanticDimensionId", "name", "category", "exclusivity", "sourceReferenceIds",
        "values", "forbiddenConflations", "status", "evidenceLevel", "gapIds"
      ],
      "properties": {
        "semanticDimensionId": { "type": "string", "pattern": "^SEM[0-9]{3,}$" },
        "name": { "$ref": "#/$defs/localizedText" },
        "category": { "enum": ["priority", "workflow-status", "feedback", "approval", "evidence-grade", "risk", "sync", "presence", "permission", "ai-state", "data-freshness", "validation", "custom"] },
        "exclusivity": { "enum": ["single", "multi"] },
        "sourceReferenceIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^REF[0-9]{3,}$" },
          "uniqueItems": true
        },
        "values": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/semanticValue" } },
        "forbiddenConflations": { "type": "array", "items": { "$ref": "#/$defs/localizedText" } },
        "status": { "enum": ["unknown", "proposed", "candidate", "approved"] },
        "evidenceLevel": { "enum": ["direct", "derived", "candidate", "approved", "unknown"] },
        "gapIds": { "$ref": "#/$defs/gapIds" }
      }
    }
  }
}
