{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UI source viewport calibration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "calibrations"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "calibrations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/calibration" } }
  },
  "$defs": {
    "size": {
      "type": "object", "additionalProperties": false, "required": ["width", "height"],
      "properties": { "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 } }
    },
    "point": {
      "type": "object", "additionalProperties": false, "required": ["x", "y"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
    },
    "bounds": {
      "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0 }, "y": { "type": "number", "minimum": 0 },
        "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "gapIds": { "type": "array", "items": { "type": "string", "pattern": "^G[0-9]{3,}$" }, "uniqueItems": true },
    "calibration": {
      "type": "object", "additionalProperties": false,
      "required": [
        "calibrationId", "referenceId", "sourceCanvas", "uiViewportBounds", "cropOffset",
        "sourceScale", "effectiveDpr", "fullContentExtent", "presentationRegions",
        "fixedRegionIds", "stickyRegionIds", "status", "evidenceLevel", "gapIds"
      ],
      "properties": {
        "calibrationId": { "type": "string", "pattern": "^CAL[0-9]{3,}$" },
        "referenceId": { "type": "string", "pattern": "^REF[0-9]{3,}$" },
        "sourceCanvas": { "$ref": "#/$defs/size" },
        "uiViewportBounds": { "$ref": "#/$defs/bounds" },
        "cropOffset": { "$ref": "#/$defs/point" },
        "sourceScale": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "effectiveDpr": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "fullContentExtent": { "$ref": "#/$defs/size" },
        "presentationRegions": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["presentationRegionId", "role", "bounds", "includeInImplementation", "evidenceLevel", "gapIds"],
            "properties": {
              "presentationRegionId": { "type": "string", "pattern": "^PR[0-9]{3,}$" },
              "role": { "enum": ["real-ui", "annotation", "redline", "measurement", "explanatory-text", "watermark", "browser-chrome", "device-frame", "unknown"] },
              "bounds": { "$ref": "#/$defs/bounds" },
              "includeInImplementation": { "type": "boolean" },
              "evidenceLevel": { "enum": ["direct", "derived", "candidate", "approved", "unknown"] },
              "gapIds": { "$ref": "#/$defs/gapIds" }
            }
          }
        },
        "fixedRegionIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "stickyRegionIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "status": { "enum": ["unknown", "proposed", "candidate", "approved"] },
        "evidenceLevel": { "enum": ["direct", "derived", "candidate", "approved", "unknown"] },
        "gapIds": { "$ref": "#/$defs/gapIds" }
      },
      "allOf": [
        {
          "if": { "anyOf": [{ "properties": { "status": { "enum": ["unknown", "proposed"] } } }, { "properties": { "evidenceLevel": { "const": "unknown" } } }] },
          "then": { "properties": { "gapIds": { "minItems": 1 } } }
        }
      ]
    }
  }
}
