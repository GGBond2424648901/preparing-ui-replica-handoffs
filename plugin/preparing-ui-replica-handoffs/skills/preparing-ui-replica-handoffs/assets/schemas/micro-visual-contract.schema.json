{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UI micro visual contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "features"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "features": { "type": "array", "items": { "$ref": "#/$defs/feature" } }
  },
  "$defs": {
    "gapIds": { "type": "array", "items": { "type": "string", "pattern": "^G[0-9]{3,}$" }, "uniqueItems": true },
    "localizedText": {
      "type": "object", "additionalProperties": false, "required": ["zh-CN", "en-US"],
      "properties": { "zh-CN": { "type": "string" }, "en-US": { "type": "string" } }
    },
    "bounds": {
      "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number" }, "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "point": {
      "type": "object", "additionalProperties": false, "required": ["x", "y"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "featureId", "pageId", "stateId", "variantId", "regionId", "name",
        "category", "renderingStrategy", "referenceIds", "assetIds", "bounds",
        "geometry", "paint", "layering", "responsiveBehavior", "diffTarget",
        "evidenceLevel", "status", "gapIds"
      ],
      "properties": {
        "featureId": { "type": "string", "pattern": "^MV[0-9]{3,}$" },
        "pageId": { "type": "string", "pattern": "^P[0-9]{3,}$" },
        "stateId": { "type": "string", "pattern": "^S[0-9]{2,}$" },
        "variantId": { "type": "string", "pattern": "^V[0-9]{2,}$" },
        "regionId": { "type": "string", "minLength": 1 },
        "name": { "$ref": "#/$defs/localizedText" },
        "category": {
          "enum": [
            "icon", "logo", "border", "corner", "shadow", "material", "gradient",
            "curve", "ring", "cylinder", "chart-mark", "illustration", "background",
            "clip-mask", "divider", "badge", "other"
          ]
        },
        "renderingStrategy": { "enum": ["svg", "css", "canvas", "raster", "dom", "library-icon", "hybrid", "unknown"] },
        "referenceIds": { "type": "array", "items": { "type": "string", "pattern": "^REF[0-9]{3,}$" }, "minItems": 1, "uniqueItems": true },
        "assetIds": { "type": "array", "items": { "type": "string", "pattern": "^A[0-9]{3,}$" }, "uniqueItems": true },
        "bounds": { "$ref": "#/$defs/bounds" },
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strokeWidth", "cornerRadii", "controlPoints", "ring", "cylinder", "transform", "pathData"],
          "properties": {
            "strokeWidth": { "type": ["number", "null"], "minimum": 0 },
            "cornerRadii": { "type": "array", "items": { "type": "number", "minimum": 0 }, "maxItems": 4 },
            "controlPoints": { "type": "array", "items": { "$ref": "#/$defs/point" } },
            "ring": {
              "type": ["object", "null"],
              "properties": {
                "outerDiameter": { "type": "number", "exclusiveMinimum": 0 },
                "innerDiameter": { "type": "number", "minimum": 0 },
                "startAngle": { "type": "number" },
                "endAngle": { "type": "number" },
                "cap": { "enum": ["butt", "round", "square", "unknown"] }
              },
              "required": ["outerDiameter", "innerDiameter", "startAngle", "endAngle", "cap"],
              "additionalProperties": false
            },
            "cylinder": {
              "type": ["object", "null"],
              "properties": {
                "bodyWidth": { "type": "number", "exclusiveMinimum": 0 },
                "bodyHeight": { "type": "number", "exclusiveMinimum": 0 },
                "capHeight": { "type": "number", "minimum": 0 },
                "axis": { "enum": ["horizontal", "vertical", "unknown"] }
              },
              "required": ["bodyWidth", "bodyHeight", "capHeight", "axis"],
              "additionalProperties": false
            },
            "transform": { "type": ["string", "null"] },
            "pathData": { "type": ["string", "null"] }
          }
        },
        "paint": {
          "type": "object", "additionalProperties": false,
          "required": ["fill", "stroke", "opacity", "gradientStops", "blur", "filter"],
          "properties": {
            "fill": { "type": ["string", "null"] }, "stroke": { "type": ["string", "null"] },
            "opacity": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
            "gradientStops": { "type": "array", "items": { "type": "object" } },
            "blur": { "type": ["number", "null"], "minimum": 0 },
            "filter": { "type": ["string", "null"] }
          }
        },
        "layering": {
          "type": "object", "additionalProperties": false, "required": ["zIndex", "clipPath", "mask", "overflow"],
          "properties": {
            "zIndex": { "type": ["integer", "null"] }, "clipPath": { "type": ["string", "null"] },
            "mask": { "type": ["string", "null"] }, "overflow": { "enum": ["visible", "hidden", "clip", "scroll", "auto", "unknown"] }
          }
        },
        "responsiveBehavior": { "$ref": "#/$defs/localizedText" },
        "diffTarget": {
          "type": "object", "additionalProperties": false,
          "required": ["comparisonModes", "geometryTolerancePx", "colorToleranceDeltaE", "opacityTolerance", "notes"],
          "properties": {
            "comparisonModes": { "type": "array", "items": { "enum": ["reference", "current", "overlay", "diff"] }, "minItems": 1, "uniqueItems": true },
            "geometryTolerancePx": { "type": "number", "minimum": 0 },
            "colorToleranceDeltaE": { "type": ["number", "null"], "minimum": 0 },
            "opacityTolerance": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
            "notes": { "$ref": "#/$defs/localizedText" }
          }
        },
        "evidenceLevel": { "enum": ["direct", "derived", "candidate", "approved", "unknown"] },
        "status": { "enum": ["unknown", "proposed", "candidate", "approved"] },
        "gapIds": { "$ref": "#/$defs/gapIds" }
      }
    }
  }
}
