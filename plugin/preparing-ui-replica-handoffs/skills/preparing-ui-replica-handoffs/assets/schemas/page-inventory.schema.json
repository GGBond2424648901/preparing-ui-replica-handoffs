{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UI page, state, and variant inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "pages"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/page" }
    }
  },
  "$defs": {
    "evidenceLevel": {
      "enum": ["direct", "derived", "candidate", "approved", "unknown"]
    },
    "lifecycleStatus": {
      "enum": ["unknown", "proposed", "candidate", "approved"]
    },
    "qaStatus": { "enum": ["not-run", "pass", "fail", "blocked"] },
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zh-CN", "en-US"],
      "properties": {
        "zh-CN": { "type": "string" },
        "en-US": { "type": "string" }
      }
    },
    "gapIds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^G[0-9]{3,}$" },
      "uniqueItems": true
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pageId",
        "stateId",
        "variantId",
        "sourceAssetIds",
        "referenceIds",
        "microVisualFeatureIds",
        "route",
        "canvas",
        "shell",
        "regions",
        "layoutRelationships",
        "copy",
        "icons",
        "components",
        "data",
        "interactions",
        "responsiveVariants",
        "acceptanceCriteria",
        "evidenceLevel",
        "status",
        "gapIds"
      ],
      "properties": {
        "pageId": { "type": "string", "pattern": "^P[0-9]{3,}$" },
        "stateId": { "type": "string", "pattern": "^S[0-9]{2,}$" },
        "variantId": { "type": "string", "pattern": "^V[0-9]{2,}$" },
        "sourceAssetIds": {
          "type": "array",
          "items": { "type": "string", "pattern": "^A[0-9]{3,}$" },
          "minItems": 1,
          "uniqueItems": true
        },
        "referenceIds": {
          "type": "array",
          "items": { "type": "string", "pattern": "^REF[0-9]{3,}$" },
          "minItems": 1,
          "uniqueItems": true
        },
        "microVisualFeatureIds": {
          "type": "array",
          "items": { "type": "string", "pattern": "^MV[0-9]{3,}$" },
          "uniqueItems": true
        },
        "route": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "evidenceLevel", "gapId"],
          "properties": {
            "path": { "type": ["string", "null"] },
            "evidenceLevel": { "$ref": "#/$defs/evidenceLevel" },
            "gapId": { "type": ["string", "null"], "pattern": "^G[0-9]{3,}$" }
          },
          "allOf": [
            {
              "if": {
                "anyOf": [
                  {
                    "properties": { "evidenceLevel": { "const": "unknown" } },
                    "required": ["evidenceLevel"]
                  },
                  {
                    "properties": { "path": { "type": "null" } },
                    "required": ["path"]
                  }
                ]
              },
              "then": { "properties": { "gapId": { "type": "string" } } }
            }
          ]
        },
        "canvas": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height", "unit"],
          "properties": {
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 },
            "unit": { "const": "px" }
          }
        },
        "shell": {
          "type": "object",
          "additionalProperties": false,
          "required": ["shellId", "evidenceLevel", "gapId"],
          "properties": {
            "shellId": { "type": "string", "minLength": 1 },
            "evidenceLevel": { "$ref": "#/$defs/evidenceLevel" },
            "gapId": { "type": ["string", "null"], "pattern": "^G[0-9]{3,}$" }
          },
          "allOf": [
            {
              "if": {
                "properties": { "evidenceLevel": { "const": "unknown" } },
                "required": ["evidenceLevel"]
              },
              "then": { "properties": { "gapId": { "type": "string" } } }
            }
          ]
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["regionId", "role", "evidenceLevel", "gapIds"],
            "properties": {
              "regionId": { "type": "string", "minLength": 1 },
              "role": {
                "enum": [
                  "header",
                  "navigation",
                  "main",
                  "aside",
                  "footer",
                  "overlay",
                  "content",
                  "unknown"
                ]
              },
              "bounds": { "$ref": "#/$defs/bounds" },
              "evidenceLevel": { "$ref": "#/$defs/evidenceLevel" },
              "gapIds": { "$ref": "#/$defs/gapIds" }
            },
            "allOf": [
              {
                "if": {
                  "anyOf": [
                    {
                      "properties": { "evidenceLevel": { "const": "unknown" } },
                      "required": ["evidenceLevel"]
                    },
                    {
                      "properties": { "role": { "const": "unknown" } },
                      "required": ["role"]
                    }
                  ]
                },
                "then": { "properties": { "gapIds": { "minItems": 1 } } }
              }
            ]
          }
        },
        "layoutRelationships": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "relationshipId",
              "containerId",
              "display",
              "relation",
              "targetIds",
              "sizingMode",
              "baseSize",
              "maxSize",
              "trackFormula",
              "growWeight",
              "shrinkPolicy",
              "desktopRole",
              "narrowDesktopBehavior",
              "wideViewportBehavior",
              "zoomBehavior",
              "evidenceLevel",
              "gapIds"
            ],
            "properties": {
              "relationshipId": { "type": "string", "minLength": 1 },
              "containerId": { "type": "string", "minLength": 1 },
              "display": { "enum": ["block", "flex", "grid", "absolute", "unknown"] },
              "relation": {
                "enum": [
                  "contains",
                  "aligns",
                  "stacks",
                  "distributes",
                  "overlaps",
                  "scrolls",
                  "unknown"
                ]
              },
              "targetIds": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "minItems": 1,
                "uniqueItems": true
              },
              "ratio": { "type": ["string", "null"] },
              "gap": { "type": ["number", "null"], "minimum": 0 },
              "minSize": { "type": ["number", "null"], "minimum": 0 },
              "sizingMode": {
                "enum": ["fixed", "fluid", "bounded-fluid", "intrinsic", "mixed", "unknown"]
              },
              "baseSize": { "type": ["number", "null"], "minimum": 0 },
              "maxSize": { "type": ["number", "null"], "minimum": 0 },
              "trackFormula": { "type": ["string", "null"] },
              "growWeight": { "type": ["number", "null"], "minimum": 0 },
              "shrinkPolicy": {
                "enum": ["preserve-min", "wrap", "reflow", "scroll", "none", "unknown"]
              },
              "desktopRole": {
                "enum": ["fixed-shell", "flexible-workspace", "bounded-content", "scroll-surface", "intrinsic", "unknown"]
              },
              "narrowDesktopBehavior": {
                "enum": ["shrink-to-min", "page-scroll", "region-scroll", "hybrid-scroll", "approved-reflow", "unknown"]
              },
              "wideViewportBehavior": {
                "enum": ["fill-available", "bounded", "preserve-fixed", "intrinsic", "unknown"]
              },
              "zoomBehavior": {
                "enum": ["effective-viewport", "preserve-layout", "unknown"]
              },
              "overflow": { "enum": ["visible", "hidden", "auto", "scroll", "unknown"] },
              "evidenceLevel": { "$ref": "#/$defs/evidenceLevel" },
              "gapIds": { "$ref": "#/$defs/gapIds" }
            },
            "allOf": [
              {
                "if": {
                  "anyOf": [
                    {
                      "properties": { "evidenceLevel": { "const": "unknown" } },
                      "required": ["evidenceLevel"]
                    },
                    {
                      "properties": { "display": { "const": "unknown" } },
                      "required": ["display"]
                    },
                    {
                      "properties": { "relation": { "const": "unknown" } },
                      "required": ["relation"]
                    },
                    {
                      "properties": { "overflow": { "const": "unknown" } },
                      "required": ["overflow"]
                    },
                    {
                      "properties": { "sizingMode": { "const": "unknown" } },
                      "required": ["sizingMode"]
                    },
                    {
                      "properties": { "shrinkPolicy": { "const": "unknown" } },
                      "required": ["shrinkPolicy"]
                    },
                    {
                      "properties": { "desktopRole": { "const": "unknown" } },
                      "required": ["desktopRole"]
                    },
                    {
                      "properties": { "narrowDesktopBehavior": { "const": "unknown" } },
                      "required": ["narrowDesktopBehavior"]
                    },
                    {
                      "properties": { "wideViewportBehavior": { "const": "unknown" } },
                      "required": ["wideViewportBehavior"]
                    },
                    {
                      "properties": { "zoomBehavior": { "const": "unknown" } },
                      "required": ["zoomBehavior"]
                    }
                  ]
                },
                "then": { "properties": { "gapIds": { "minItems": 1 } } }
              }
            ]
          }
        },
        "copy": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "copyId",
              "text",
              "classification",
              "evidenceLevel",
              "sourceBounds",
              "gapId"
            ],
            "properties": {
              "copyId": { "type": "string", "minLength": 1 },
              "text": { "$ref": "#/$defs/localizedText" },
              "classification": {
                "enum": ["verbatim", "verified", "inferred", "unknown"]
              },
              "evidenceLevel": { "$ref": "#/$defs/evidenceLevel" },
              "sourceBounds": { "$ref": "#/$defs/bounds" },
              "gapId": {
                "type": ["string", "null"],
                "pattern": "^G[0-9]{3,}$"
              }
            },
            "allOf": [
              {
                "if": {
                  "anyOf": [
                    {
                      "properties": { "evidenceLevel": { "const": "unknown" } },
                      "required": ["evidenceLevel"]
                    },
                    {
                      "properties": { "classification": { "enum": ["inferred", "unknown"] } },
                      "required": ["classification"]
                    }
                  ]
                },
                "then": { "properties": { "gapId": { "type": "string" } } }
              }
            ]
          }
        },
        "icons": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["iconId", "assetId", "meaning", "evidenceLevel", "gapId"],
            "properties": {
              "iconId": { "type": "string", "minLength": 1 },
              "assetId": { "type": ["string", "null"] },
              "meaning": { "$ref": "#/$defs/localizedText" },
              "evidenceLevel": { "$ref": "#/$defs/evidenceLevel" },
              "gapId": { "type": ["string", "null"], "pattern": "^G[0-9]{3,}$" }
            },
            "allOf": [
              {
                "if": {
                  "anyOf": [
                    {
                      "properties": { "evidenceLevel": { "const": "unknown" } },
                      "required": ["evidenceLevel"]
                    },
                    {
                      "properties": { "assetId": { "type": "null" } },
                      "required": ["assetId"]
                    }
                  ]
                },
                "then": { "properties": { "gapId": { "type": "string" } } }
              }
            ]
          }
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["instanceId", "componentId", "regionId", "evidenceLevel", "gapId"],
            "properties": {
              "instanceId": { "type": "string", "minLength": 1 },
              "componentId": { "type": "string", "minLength": 1 },
              "regionId": { "type": "string", "minLength": 1 },
              "evidenceLevel": { "$ref": "#/$defs/evidenceLevel" },
              "gapId": { "type": ["string", "null"], "pattern": "^G[0-9]{3,}$" }
            },
            "allOf": [
              {
                "if": {
                  "properties": { "evidenceLevel": { "const": "unknown" } },
                  "required": ["evidenceLevel"]
                },
                "then": { "properties": { "gapId": { "type": "string" } } }
              }
            ]
          }
        },
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dataId", "classification", "valueShape", "evidenceLevel", "gapId"],
            "properties": {
              "dataId": { "type": "string", "minLength": 1 },
              "classification": { "enum": ["sample", "verified", "unknown"] },
              "valueShape": { "type": "string", "minLength": 1 },
              "sourceRef": { "type": ["string", "null"] },
              "evidenceLevel": { "$ref": "#/$defs/evidenceLevel" },
              "gapId": { "type": ["string", "null"], "pattern": "^G[0-9]{3,}$" }
            },
            "allOf": [
              {
                "if": {
                  "anyOf": [
                    {
                      "properties": { "evidenceLevel": { "const": "unknown" } },
                      "required": ["evidenceLevel"]
                    },
                    {
                      "properties": { "classification": { "const": "unknown" } },
                      "required": ["classification"]
                    }
                  ]
                },
                "then": { "properties": { "gapId": { "type": "string" } } }
              }
            ]
          }
        },
        "interactions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "interactionId",
              "trigger",
              "outcome",
              "status",
              "evidenceLevel",
              "gapId"
            ],
            "properties": {
              "interactionId": { "type": "string", "minLength": 1 },
              "trigger": { "type": "string", "minLength": 1 },
              "outcome": { "$ref": "#/$defs/localizedText" },
              "status": { "$ref": "#/$defs/lifecycleStatus" },
              "evidenceLevel": { "$ref": "#/$defs/evidenceLevel" },
              "gapId": {
                "type": ["string", "null"],
                "pattern": "^G[0-9]{3,}$"
              }
            },
            "allOf": [
              {
                "if": {
                  "anyOf": [
                    {
                      "properties": { "status": { "enum": ["unknown", "proposed"] } },
                      "required": ["status"]
                    },
                    {
                      "properties": { "evidenceLevel": { "const": "unknown" } },
                      "required": ["evidenceLevel"]
                    }
                  ]
                },
                "then": { "properties": { "gapId": { "type": "string" } } }
              }
            ]
          }
        },
        "responsiveVariants": {
          "type": "array",
          "minItems": 1,
          "contains": {
            "type": "object",
            "properties": { "mode": { "enum": ["baseline-elastic", "baseline-scroll"] } },
            "required": ["mode"]
          },
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "responsiveVariantId",
              "mode",
              "targetPlatform",
              "layoutPolicy",
              "minWidth",
              "evidenceLevel",
              "status",
              "gapIds"
            ],
            "properties": {
              "responsiveVariantId": { "type": "string", "minLength": 1 },
              "mode": { "enum": ["baseline-elastic", "baseline-scroll", "responsive"] },
              "targetPlatform": {
                "enum": ["desktop-web", "mobile-web", "responsive-web", "desktop-native", "unknown"]
              },
              "layoutPolicy": {
                "enum": ["desktop-hybrid-elastic", "fully-fluid", "fixed-baseline", "evidence-defined", "unknown"]
              },
              "minWidth": { "type": ["number", "null"], "minimum": 0 },
              "maxWidth": { "type": ["number", "null"], "minimum": 0 },
              "evidenceLevel": { "$ref": "#/$defs/evidenceLevel" },
              "status": { "$ref": "#/$defs/lifecycleStatus" },
              "gapIds": { "$ref": "#/$defs/gapIds" }
            },
            "allOf": [
              {
                "if": {
                  "anyOf": [
                    {
                      "properties": { "status": { "enum": ["unknown", "proposed"] } },
                      "required": ["status"]
                    },
                    {
                      "properties": { "evidenceLevel": { "const": "unknown" } },
                      "required": ["evidenceLevel"]
                    },
                    {
                      "properties": { "targetPlatform": { "const": "unknown" } },
                      "required": ["targetPlatform"]
                    },
                    {
                      "properties": { "layoutPolicy": { "const": "unknown" } },
                      "required": ["layoutPolicy"]
                    }
                  ]
                },
                "then": { "properties": { "gapIds": { "minItems": 1 } } }
              },
              {
                "if": {
                  "properties": { "mode": { "const": "responsive" } },
                  "required": ["mode"]
                },
                "then": {
                  "anyOf": [
                    {
                      "properties": { "evidenceLevel": { "enum": ["direct", "approved"] } },
                      "required": ["evidenceLevel"]
                    },
                    {
                      "properties": { "status": { "const": "approved" } },
                      "required": ["status"]
                    }
                  ]
                }
              }
            ]
          }
        },
        "acceptanceCriteria": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["qaId", "evidenceTypes", "status"],
            "properties": {
              "qaId": { "type": "string", "pattern": "^QA[0-9]{3,}$" },
              "evidenceTypes": {
                "type": "array",
                "items": { "enum": ["visual", "structural", "interaction"] },
                "minItems": 1,
                "uniqueItems": true
              },
              "status": { "$ref": "#/$defs/qaStatus" }
            }
          }
        },
        "evidenceLevel": { "$ref": "#/$defs/evidenceLevel" },
        "status": { "$ref": "#/$defs/lifecycleStatus" },
        "gapIds": { "$ref": "#/$defs/gapIds" }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "properties": { "status": { "enum": ["unknown", "proposed"] } },
                "required": ["status"]
              },
              {
                "properties": { "evidenceLevel": { "const": "unknown" } },
                "required": ["evidenceLevel"]
              }
            ]
          },
          "then": { "properties": { "gapIds": { "minItems": 1 } } }
        }
      ]
    }
  }
}
