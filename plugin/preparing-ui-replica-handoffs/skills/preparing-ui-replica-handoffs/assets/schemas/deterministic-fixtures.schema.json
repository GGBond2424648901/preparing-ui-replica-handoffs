{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deterministic UI capture fixtures",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fixtures"],
  "properties": { "schemaVersion": { "const": "1.0.0" }, "fixtures": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fixture" } } },
  "$defs": {
    "relativePath": { "type": "string", "minLength": 1, "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "gapIds": { "type": "array", "items": { "type": "string", "pattern": "^G[0-9]{3,}$" }, "uniqueItems": true },
    "fixture": {
      "type": "object", "additionalProperties": false,
      "required": ["fixtureId", "pageId", "stateId", "variantId", "locale", "permissionProfile", "clock", "timezone", "randomSeed", "dataFixturePath", "assetIds", "networkState", "animationState", "cursor", "scrollPositions", "dynamicMaskIds", "status", "evidenceLevel", "gapIds"],
      "properties": {
        "fixtureId": { "type": "string", "pattern": "^FIX[0-9]{3,}$" },
        "pageId": { "type": "string", "pattern": "^P[0-9]{3,}$" }, "stateId": { "type": "string", "pattern": "^S[0-9]{2,}$" }, "variantId": { "type": "string", "pattern": "^V[0-9]{2,}$" },
        "locale": { "type": "string", "minLength": 1 }, "permissionProfile": { "type": "string", "minLength": 1 },
        "clock": { "type": "string", "minLength": 1 }, "timezone": { "type": "string", "minLength": 1 },
        "randomSeed": { "type": ["integer", "null"] },
        "dataFixturePath": { "anyOf": [{ "$ref": "#/$defs/relativePath" }, { "type": "null" }] },
        "assetIds": { "type": "array", "items": { "type": "string", "pattern": "^A[0-9]{3,}$" }, "uniqueItems": true },
        "networkState": { "enum": ["settled", "loading", "offline", "error", "unknown"] },
        "animationState": { "enum": ["completed", "paused", "reduced-motion", "running", "unknown"] },
        "cursor": { "enum": ["hidden", "visible", "unknown"] },
        "scrollPositions": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["ownerId", "x", "y"], "properties": { "ownerId": { "type": "string", "minLength": 1 }, "x": { "type": "number" }, "y": { "type": "number" } } } },
        "dynamicMaskIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "status": { "enum": ["unknown", "proposed", "candidate", "approved"] },
        "evidenceLevel": { "enum": ["direct", "derived", "candidate", "approved", "unknown"] },
        "gapIds": { "$ref": "#/$defs/gapIds" }
      },
      "allOf": [{ "if": { "anyOf": [{ "properties": { "status": { "enum": ["unknown", "proposed"] } } }, { "properties": { "evidenceLevel": { "const": "unknown" } } }] }, "then": { "properties": { "gapIds": { "minItems": 1 } } } }]
    }
  }
}
