{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UI implementation map and Git scope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "gitScope", "mappings"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "gitScope": { "$ref": "#/$defs/gitScope" },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/mapping" }
    }
  },
  "$defs": {
    "evidenceLevel": {
      "enum": ["direct", "derived", "candidate", "approved", "unknown"]
    },
    "lifecycleStatus": {
      "enum": ["unknown", "proposed", "candidate", "approved"]
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "relativePaths": {
      "type": "array",
      "items": { "$ref": "#/$defs/relativePath" },
      "uniqueItems": true
    },
    "gapIds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^G[0-9]{3,}$" },
      "uniqueItems": true
    },
    "gitScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryRelativeRoot", "allowedNewPaths", "allowedModifiedPaths"],
      "properties": {
        "repositoryRelativeRoot": { "$ref": "#/$defs/relativePath" },
        "allowedNewPaths": { "$ref": "#/$defs/relativePaths" },
        "allowedModifiedPaths": { "$ref": "#/$defs/relativePaths" }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pageId",
        "stateId",
        "variantId",
        "route",
        "targetFiles",
        "shellComponentId",
        "regionMappings",
        "componentMappings",
        "dataBindings",
        "interactionMappings",
        "responsiveMappings",
        "evidenceLevel",
        "status",
        "gapIds"
      ],
      "properties": {
        "pageId": { "type": "string", "pattern": "^P[0-9]{3,}$" },
        "stateId": { "type": "string", "pattern": "^S[0-9]{2,}$" },
        "variantId": { "type": "string", "pattern": "^V[0-9]{2,}$" },
        "route": { "type": ["string", "null"] },
        "targetFiles": { "$ref": "#/$defs/relativePaths" },
        "shellComponentId": { "type": ["string", "null"] },
        "regionMappings": { "$ref": "#/$defs/regionMappings" },
        "componentMappings": { "$ref": "#/$defs/componentMappings" },
        "dataBindings": { "$ref": "#/$defs/dataBindings" },
        "interactionMappings": { "$ref": "#/$defs/interactionMappings" },
        "responsiveMappings": { "$ref": "#/$defs/responsiveMappings" },
        "evidenceLevel": { "$ref": "#/$defs/evidenceLevel" },
        "status": { "$ref": "#/$defs/lifecycleStatus" },
        "gapIds": { "$ref": "#/$defs/gapIds" }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "properties": { "status": { "enum": ["unknown", "proposed"] } },
                "required": ["status"]
              },
              {
                "properties": { "evidenceLevel": { "const": "unknown" } },
                "required": ["evidenceLevel"]
              }
            ]
          },
          "then": { "properties": { "gapIds": { "minItems": 1 } } }
        }
      ]
    },
    "regionMappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["regionId", "targetSelector", "targetFile", "evidenceLevel", "gapIds"],
        "properties": {
          "regionId": { "type": "string", "minLength": 1 },
          "targetSelector": { "type": "string", "minLength": 1 },
          "targetFile": { "$ref": "#/$defs/relativePath" },
          "evidenceLevel": { "$ref": "#/$defs/evidenceLevel" },
          "gapIds": { "$ref": "#/$defs/gapIds" }
        },
        "allOf": [
          {
            "if": {
              "properties": { "evidenceLevel": { "const": "unknown" } },
              "required": ["evidenceLevel"]
            },
            "then": { "properties": { "gapIds": { "minItems": 1 } } }
          }
        ]
      }
    },
    "componentMappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["instanceId", "componentId", "targetSymbol", "targetFile", "evidenceLevel", "gapIds"],
        "properties": {
          "instanceId": { "type": "string", "minLength": 1 },
          "componentId": { "type": "string", "minLength": 1 },
          "targetSymbol": { "type": "string", "minLength": 1 },
          "targetFile": { "$ref": "#/$defs/relativePath" },
          "evidenceLevel": { "$ref": "#/$defs/evidenceLevel" },
          "gapIds": { "$ref": "#/$defs/gapIds" }
        },
        "allOf": [
          {
            "if": {
              "properties": { "evidenceLevel": { "const": "unknown" } },
              "required": ["evidenceLevel"]
            },
            "then": { "properties": { "gapIds": { "minItems": 1 } } }
          }
        ]
      }
    },
    "dataBindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dataId", "targetSource", "classification", "evidenceLevel", "gapId"],
        "properties": {
          "dataId": { "type": "string", "minLength": 1 },
          "targetSource": { "type": ["string", "null"] },
          "classification": { "enum": ["sample", "verified", "unknown"] },
          "evidenceLevel": { "$ref": "#/$defs/evidenceLevel" },
          "gapId": { "type": ["string", "null"], "pattern": "^G[0-9]{3,}$" }
        },
        "allOf": [
          {
            "if": {
              "anyOf": [
                {
                  "properties": { "evidenceLevel": { "const": "unknown" } },
                  "required": ["evidenceLevel"]
                },
                {
                  "properties": { "classification": { "const": "unknown" } },
                  "required": ["classification"]
                }
              ]
            },
            "then": { "properties": { "gapId": { "type": "string" } } }
          }
        ]
      }
    },
    "interactionMappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["interactionId", "targetHandler", "status", "evidenceLevel", "gapId"],
        "properties": {
          "interactionId": { "type": "string", "minLength": 1 },
          "targetHandler": { "type": ["string", "null"] },
          "status": { "$ref": "#/$defs/lifecycleStatus" },
          "evidenceLevel": { "$ref": "#/$defs/evidenceLevel" },
          "gapId": { "type": ["string", "null"], "pattern": "^G[0-9]{3,}$" }
        },
        "allOf": [
          {
            "if": {
              "anyOf": [
                {
                  "properties": { "status": { "enum": ["unknown", "proposed"] } },
                  "required": ["status"]
                },
                {
                  "properties": { "evidenceLevel": { "const": "unknown" } },
                  "required": ["evidenceLevel"]
                }
              ]
            },
            "then": { "properties": { "gapId": { "type": "string" } } }
          }
        ]
      }
    },
    "responsiveMappings": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "type": "object",
        "properties": { "strategy": { "enum": ["baseline-elastic", "baseline-scroll"] } },
        "required": ["strategy"]
      },
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["responsiveVariantId", "strategy", "targetPlatform", "layoutPolicy", "targetFiles", "status", "evidenceLevel", "gapIds"],
        "properties": {
          "responsiveVariantId": { "type": "string", "minLength": 1 },
          "strategy": { "enum": ["baseline-elastic", "baseline-scroll", "responsive"] },
          "targetPlatform": {
            "enum": ["desktop-web", "mobile-web", "responsive-web", "desktop-native", "unknown"]
          },
          "layoutPolicy": {
            "enum": ["desktop-hybrid-elastic", "fully-fluid", "fixed-baseline", "evidence-defined", "unknown"]
          },
          "targetFiles": { "$ref": "#/$defs/relativePaths" },
          "status": { "$ref": "#/$defs/lifecycleStatus" },
          "evidenceLevel": { "$ref": "#/$defs/evidenceLevel" },
          "gapIds": { "$ref": "#/$defs/gapIds" }
        },
        "allOf": [
          {
            "if": {
              "anyOf": [
                {
                  "properties": { "status": { "enum": ["unknown", "proposed"] } },
                  "required": ["status"]
                },
                {
                  "properties": { "evidenceLevel": { "const": "unknown" } },
                  "required": ["evidenceLevel"]
                },
                {
                  "properties": { "targetPlatform": { "const": "unknown" } },
                  "required": ["targetPlatform"]
                },
                {
                  "properties": { "layoutPolicy": { "const": "unknown" } },
                  "required": ["layoutPolicy"]
                }
              ]
            },
            "then": { "properties": { "gapIds": { "minItems": 1 } } }
          },
          {
            "if": {
              "properties": { "strategy": { "const": "responsive" } },
              "required": ["strategy"]
            },
            "then": {
              "anyOf": [
                {
                  "properties": { "evidenceLevel": { "enum": ["direct", "approved"] } },
                  "required": ["evidenceLevel"]
                },
                {
                  "properties": { "status": { "const": "approved" } },
                  "required": ["status"]
                }
              ]
            }
          }
        ]
      }
    }
  }
}
